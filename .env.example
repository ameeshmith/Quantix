# ==============================================================================
# Quantix Environment Configuration
# ==============================================================================

# Required: SEC EDGAR User-Agent (format: 'YourAppName contact@yourdomain.com')
# SEC EDGAR strictly blocks requests lacking a valid contact email.
EDGAR_USER_AGENT=QuantixResearch analyst@example.com

# SQLite Database Location
DB_PATH=quantix.db

# MCP Server Transport Configuration
# Options: 'stdio' (for Claude Desktop / local CLI) or 'streamable-http' (for remote web/API access)
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000

# MCP HTTP Authentication Token (Required when MCP_TRANSPORT=streamable-http)
MCP_API_KEY=your_secure_bearer_token_here

# LLM Provider Configuration
# Supported providers: 'anthropic', 'openai', or custom openai-compatible endpoints
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Generic or provider-specific keys:
LLM_API_KEY=your_llm_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# Optional custom endpoint (e.g. Ollama, OpenRouter, vLLM, Azure OpenAI)
LLM_BASE_URL=

# Scheduled Alerts & Telegram Notifications
# Optional: if provided, APScheduler sends newly detected 8-K filing briefs to Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Cron expression for daily watchlist checks (default: 8:00 AM Monday-Friday)
ALERT_SCHEDULE=0 8 * * 1-5

# Testing Configuration (0 = mock SEC EDGAR, 1 = execute live smoke test)
RUN_LIVE_TESTS=0

